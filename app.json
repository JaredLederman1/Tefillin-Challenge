{
  "expo": {
    "name": "Ratzon",
    "slug": "tefillin-challenge",
    "scheme": [
      "ratzon",
      "levav",
      "tefillinchallenge"
    ],
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDF4FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jaredlederman.tefillinchallenge",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.jaredlederman.tefillinchallenge",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EDF4FF",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Take your daily tefillin photo.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-iap",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2aa59bac-2432-44e5-959a-8c46c6333ef7"
      }
    },
    "owner": "jaredlederman"
  }
}
